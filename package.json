{
  "name": "lumendia-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/astro.mjs dev --host 127.0.0.1",
    "build": "node scripts/build.mjs production",
    "build:preview": "node scripts/build.mjs preview",
    "preview": "node scripts/astro.mjs preview --host 127.0.0.1",
    "check": "node scripts/astro.mjs check",
    "test": "node scripts/release.mjs",
    "release:check": "node scripts/release.mjs",
    "audit:repository": "node scripts/repository-audit.mjs",
    "build:institutional": "node scripts/build-institutional.mjs",
    "build:library": "node scripts/build.mjs library",
    "release:library": "node scripts/release-library.mjs",
    "prepare:publication": "node scripts/build-institutional.mjs && node scripts/prepare-institutional.mjs",
    "test:institutional": "node scripts/release.mjs",
    "test:library": "node scripts/validate.mjs dist-library",
    "test:institutional:browser": "playwright test --config=playwright.institutional.config.ts",
    "build:library:dry-run": "node scripts/build.mjs dry-run",
    "test:library:browser": "playwright test",
    "package:library": "node scripts/package-library.mjs",
    "publish:library": "node scripts/publish-library.mjs"
  },
  "dependencies": {
    "astro": "^7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.6.5",
    "typescript": "^5.9.0"
  }
}
