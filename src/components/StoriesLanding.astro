---
import {editorialEntries} from '../lib/editorial-catalog';
import {availableAuthors,authorUrl} from '../lib/editorial-authors';
import {minutes,preview} from '../lib/catalog';
const author=availableAuthors.find(a=>a.slug==='gael-beltra');
const stories=editorialEntries.filter(e=>e.format==='story'&&e.scope==='complete'&&(preview||(!e.privateDraft&&!e.publicationPending))).sort((a,b)=>(b.publishedAt??'').localeCompare(a.publishedAt??'')||a.slug.localeCompare(b.slug));
---
<div class="container stories-landing">
<header class="stories-intro"><p class="eyebrow">Relatos gratuitos</p><h1>Una pausa para otra historia</h1><p>Historias para leer completas y gratis en Lumendia.</p></header>
<div class="stories-grid">{stories.map(story=>{return <article class="story-card">
<div class:list={['story-art',{'story-forest':story.slug==='el-silbido-detras-del-monte','story-door':story.slug==='la-habitacion-que-no-figuraba'}]} aria-hidden="true">{story.illustration?<img src={story.illustration.src} width={story.illustration.width} height={story.illustration.height} alt="" loading="lazy" decoding="async"/>:<span class="scene-shape"></span>}</div>
<div class="story-copy"><p class="eyebrow">{story.topics.join(' · ')}</p><h2><a href={story.url}>{story.title}</a></h2><p>{story.description}</p><p class="small">{story.author?.name} · {minutes(story.words)} minutos aproximadamente</p><a class="story-link" href={story.url}>Leer el relato completo →</a></div>
</article>})}</div>
{author&&<>
<section class="author-strip" aria-labelledby="gael-title"><img src={author.logo} width="640" height="640" alt={`Logo oficial de ${author.name}`} loading="lazy" decoding="async"/><div><p class="eyebrow">{author.publisher}</p><h2 id="gael-title">{author.name}</h2><p>{author.description}</p><a class="story-link" href={authorUrl(author.slug)}>Conocé la página completa de Gael Beltra →</a></div></section>
<section aria-labelledby="novelas-title"><h2 id="novelas-title" class="novels-title">Novelas de Gael Beltra en Amazon</h2><p>Obras comerciales. Los enlaces llevan a sus fichas en Amazon.</p><div class="novels-grid">{author.novels.map(n=><article class="novel-card"><div class="novel-art"><img src={n.cover} width={n.coverWidth} height={n.coverHeight} alt={`Portada oficial de ${n.title}, de Gael Beltra`} loading="lazy" decoding="async"/></div><div class="novel-copy"><p class="small">Novela · Obra comercial</p><h3>{n.title}</h3><p class="small">{n.genre}</p><p>{n.description}</p><a class="story-link" href={n.url} rel="noreferrer" aria-label={`Ver en Amazon: ${n.title}`}>Ver en Amazon ↗</a></div></article>)}</div></section>
</>}
</div>
<style>
.stories-landing{padding-block:30px 60px}.stories-intro{max-width:850px;margin-bottom:30px}.stories-intro h1{font:clamp(36px,5vw,56px)/1.12 var(--serif);margin:14px 0}.stories-intro>p:last-child{font-size:19px;color:var(--muted)}.stories-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.story-card,.novel-card{border:1px solid var(--line);background:var(--soft);border-radius:8px;overflow:hidden;display:flex;flex-direction:column}.story-art{position:relative;height:234px;flex-shrink:0;overflow:hidden;background:#153f35}.story-art img{width:100%;height:100%;object-fit:cover}.story-forest{background:radial-gradient(ellipse at 70% 0%,#51736780,transparent 60%),linear-gradient(180deg,#234f43,#102d27)}.story-forest:before{content:"";position:absolute;inset:0;background:repeating-linear-gradient(94deg,transparent 0 48px,#0b261ecc 49px 56px,transparent 58px 91px);transform:scale(1.15)}.story-forest:after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,#102d27,transparent 65%),repeating-linear-gradient(145deg,transparent 0 45px,#69847225 46px 48px,transparent 49px 88px)}.story-forest .scene-shape{position:absolute;width:85px;height:85px;border:1px solid #b6873970;border-radius:50%;top:34px;right:22%;background:#b6873912}.story-door{background:linear-gradient(155deg,transparent 49.5%,#66847544 50%,transparent 50.5%) left/50% 100% no-repeat,linear-gradient(205deg,transparent 49.5%,#66847544 50%,transparent 50.5%) right/50% 100% no-repeat,#153f35}.story-door .scene-shape{position:absolute;top:32px;bottom:0;width:104px;left:calc(50% - 52px);border:1px solid #b6873990;border-bottom:0;background:linear-gradient(95deg,#091e1a 0 90%,#b6873970 92%,#193f34 94%);box-shadow:0 0 0 17px #0c2d2440,0 0 0 18px #66847540}.story-door:after{content:"";position:absolute;bottom:0;left:calc(50% - 52px);width:104px;height:55px;background:linear-gradient(0deg,#b6873910,#b6873945);clip-path:polygon(90% 0,100% 0,100% 100%,0 100%)}.story-copy,.novel-copy{padding:24px;display:flex;flex-direction:column;flex:1}.story-copy h2{font:30px/1.2 var(--serif);margin:12px 0}.story-copy p,.novel-copy p{line-height:1.65}.story-link{display:inline-flex;align-items:center;min-height:48px;margin-top:auto;font-weight:700}.author-strip{display:grid;grid-template-columns:150px minmax(0,1fr);align-items:center;gap:30px;padding:30px;background:var(--paper);border:1px solid var(--line);border-radius:8px;margin:40px 0}.author-strip img{width:150px;height:150px;border-radius:50%}.author-strip h2{font:36px var(--serif);margin:10px 0}.novels-title{font:36px/1.2 var(--serif)}.novels-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin-top:24px}.novel-art{padding:24px 20px 0;display:flex;justify-content:center}.novel-art img{height:280px;width:auto;max-width:100%;object-fit:contain}.novel-copy h3{font:28px/1.2 var(--serif);margin:10px 0}.novel-copy>p{margin:8px 0}.novel-copy .story-link{padding-top:16px}a:focus-visible{outline:3px solid var(--gold);outline-offset:4px}@media(max-width:800px){.stories-grid,.novels-grid{grid-template-columns:1fr}.author-strip{grid-template-columns:1fr;padding:24px;gap:12px}.author-strip img{width:120px;height:120px}.stories-landing{padding-top:20px}.story-copy,.novel-copy{padding:20px}.novel-art img{height:280px}.novels-title{font-size:30px}}
</style>
