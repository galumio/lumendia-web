---
import {editorialEntries} from '../lib/editorial-catalog';
const {home=false}=Astro.props;
const links=[
 {href:'/biblioteca/',icon:'M3 4h7l2 2 2-2h7v15h-7l-2 2-2-2H3V4 M12 6v15',tone:'card-0',action:'Ver libros y muestras',title:'Encontrar una lectura',description:'Libros y muestras con su alcance indicado.'},
 ...(editorialEntries.some(e=>e.format==='guide')?[{href:'/guias/',icon:'M4 3h16v18H4z M8 7h8 M8 11h8 M8 15h5',tone:'card-1',action:'Leer las guías',title:'Empezar con una guía',description:'Una explicación completa para avanzar a tu ritmo.'}]:[]),
 ...(editorialEntries.some(e=>e.format==='tutorial')?[{href:'/tutoriales/',icon:'M3 18h6v-6h6V6h6 M17 6h4v4',tone:'card-2',action:'Elegir un tutorial',title:'Aprender paso a paso',description:'Tutoriales para resolver una tarea concreta.'}]:[]),
 {href:'/herramientas/generador-de-prompts/',icon:'M4 16 16 4l4 4L8 20H4z M13 7l4 4',tone:'card-4',action:'Crear mi pedido',title:'Preparar un pedido para la IA',description:'Generador gratuito. Sin registro ni envío de tus textos.'},
 {href:'/recursos/',icon:'M12 3v12 M7 10l5 5 5-5 M4 16v5h16v-5',tone:'card-5',action:'Ver recursos gratuitos',title:'Buscar recursos para imprimir',description:'Descargas gratuitas, identificadas como PDF.'}
];
---
<section class="container section start-here" aria-labelledby="start-title">{home?<h1 id="start-title">¿Qué te gustaría <br/>hacer hoy?</h1>:<h2 id="start-title">¿Qué te gustaría hacer hoy?</h2>}<p>Libros, guías y herramientas gratuitas para leer, aprender y resolver cosas de todos los días</p><nav class="start-grid" aria-label="Elegí cómo empezar">{links.map(link=><a href={link.href} class={`start-card ${link.tone}`}><svg class="start-symbol" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={link.icon}/></svg><strong>{link.title}</strong><span>{link.description}</span><span class="start-action" aria-hidden="true">{link.action} →</span></a>)}</nav></section>
