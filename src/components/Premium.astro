---
import type {Book} from '../lib/catalog';
interface Props {cover:string;product:NonNullable<Book['premium']>}
const {cover,product}=Astro.props;
---
<section class="premium" id="kit"><div class="kit-image"><img src={cover} alt={`Portada de la edición descargable: ${product.title}`} width="180" height="255" loading="lazy"/><span>EDICIÓN<br/>DESCARGABLE</span></div><div><span class="eyebrow">Para tener a mano · Galumio Studio</span><h2>{product.title}</h2><p>{product.description}</p><ul>{product.items.map(item=><li>{item}</li>)}</ul>{product.note&&<p class="small">{product.note}</p>}{product.url?<a class="button" href={product.url} rel="noopener" data-event="commercial_click">{product.cta??'Ver en Galumio Studio'} ↗</a>:<p class="availability">Venta externa en preparación</p>}<p class="small">La lectura web es gratuita. La edición descargable se compra en la tienda de Galumio Studio.</p></div></section>
