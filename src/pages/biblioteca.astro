---
import Base from '../layouts/Base.astro';import BookCard from '../components/BookCard.astro';import {available,categories} from '../lib/catalog';
---
<Base title="Biblioteca digital gratuita" description="Explorá la biblioteca de Lumendia. Buscá guías y ebooks gratuitos por tema, con lectura organizada por capítulos."><section class="container section"><span class="eyebrow">Lecturas para ir más lejos</span><h1>Tu próxima respuesta<br/>puede empezar <em>acá.</em></h1><p class="section-intro">Explorá nuestra biblioteca. Elegí un tema y leé a tu ritmo.</p><div class="search-box" data-search="books"><label>Buscar en la biblioteca<input type="search" placeholder="Título, tema o palabra clave" autocomplete="off"/></label><label>Categoría<select><option value="">Todas las categorías</option>{categories.map(c=><option value={c}>{c}</option>)}</select></label><button type="button" class="button secondary">Limpiar filtros</button></div><p data-results role="status" aria-live="polite"></p><div class="book-list">{available.map(book=><BookCard book={book}/>)}</div>{!available.length&&<p>La primera guía está pendiente de aprobación editorial.</p>}<p class="small">Las categorías sin publicaciones se incorporarán más adelante.</p></section><script>const selected=new URLSearchParams(location.search).get('categoria');const select=document.querySelector('select');if(selected&&select){select.value=selected;select.dispatchEvent(new Event('change'))}</script></Base>
