---
import Discovery from '../layouts/Discovery.astro';
import BookCard from '../components/BookCard.astro';
import {available} from '../lib/catalog';
import {readingScope} from '../lib/editorial';
import {publishedBook} from '../lib/discovery.mjs';
const complete=available.filter(b=>readingScope(b)==='complete'&&publishedBook(b));
---
<Discovery title="Libros para leer completos." description="Lectura gratuita online, sin registro. Los recursos PDF independientes tienen su propia sección."><div class="reading-grid">{complete.map(book=><BookCard book={book}/>)}</div><a href="/recursos/">Ver recursos gratuitos independientes →</a></Discovery>
