---
import Base from '../layouts/Base.astro';import {config} from '../lib/catalog';
// Los textos legales son definitivos solo con responsable, contacto y jurisdicción cargados en site.config.json.
const legalReady=Boolean(config.legal.approved&&config.legal.responsibleName&&config.contactEmail&&config.legal.jurisdiction);
const editorialReady=Boolean(config.editorial.approved&&config.editorial.reviewer&&config.editorial.reviewedAt);
const responsible=config.legal.responsibleName||'[responsable pendiente]';
const email=config.contactEmail||'[correo pendiente]';
const jurisdiction=config.legal.jurisdiction||'[jurisdicción pendiente]';
const legalEyebrow=(label:string)=>legalReady?label:`${label} · Borrador pendiente de aprobación`;
const pages=[
{slug:'sobre-lumendia',title:'Conocimiento para ir más lejos.',eyebrow:'Sobre Lumendia',sections:[['Una biblioteca abierta','Lumendia nace para poner el conocimiento al alcance de todos. Compartimos guías, ebooks y recursos educativos completos para leer gratuitamente en la web, sin cuentas ni suscripciones.'],['Empezamos por el cuidado','Nuestra primera publicación está dirigida a familias y cuidadores de personas con Alzheimer o demencia. La biblioteca está preparada para crecer hacia otros temas, que aún no tienen publicaciones.'],['Lectura libre, formatos para elegir','La lectura online es gratuita. Algunas publicaciones tienen una edición descargable premium comercializada por Galumio. Lumendia y Galumio son marcas independientes.'],['Nuestra forma de trabajar','Priorizamos textos claros, navegación accesible y fuentes identificables. El material sanitario necesita aprobación editorial y revisión profesional antes de publicarse. No atribuimos revisiones que no estén acreditadas.']]},
{slug:'contacto',title:'Conversemos.',eyebrow:'Contacto',sections:legalReady?[['Escribinos',`Para consultas, sugerencias o correcciones escribí a ${email}. No hay formularios: tu mensaje llega solo por correo electrónico.`],['Correcciones y consultas editoriales','Indicá la URL, el capítulo y el fragmento que querés revisar. No envíes historias clínicas, datos médicos ni información identificable de otras personas.'],['Alcance','Lumendia es una biblioteca educativa. No ofrece consultas médicas, diagnósticos ni atención de emergencias. Ante una urgencia, comunicate con el servicio de emergencias de tu zona.']]:[['Canal de contacto en preparación','El correo de atención de Lumendia todavía no fue informado. Se incorporará antes de la publicación. Por ahora no hay un formulario de envío ni se reciben consultas desde esta página.'],['Correcciones y consultas editoriales','Al habilitarse el canal, podrás indicar la URL, el capítulo y el fragmento que querés revisar. No envíes historias clínicas, datos médicos ni información identificable de otras personas.'],['Alcance','Lumendia es una biblioteca educativa. No ofrece consultas médicas, diagnósticos ni atención de emergencias.']]},
{slug:'privacidad',title:'Política de privacidad',eyebrow:legalEyebrow('Privacidad'),sections:[['Responsable',`El responsable de Lumendia (lumendia.com.ar) es ${responsible}. Contacto: ${email}.`],['Datos que utiliza la lectura','Lumendia no exige cuentas ni solicita datos personales o médicos. El navegador conserva localmente el tema visual, el tamaño de letra, el último capítulo, la posición de lectura y, cuando corresponda, tu preferencia de consentimiento. Estos datos no se envían a Lumendia.'],['Descargas y alojamiento','Descargar un recurso no requiere correo electrónico. El sitio se aloja en GitHub Pages (GitHub, Inc., Estados Unidos), que puede procesar datos técnicos como la dirección IP y registros de acceso para prestar el servicio y protegerlo, conforme a sus propias políticas.'],['Servicios opcionales','La analítica y la publicidad están desactivadas. Si se habilitan, esta política se actualizará con los proveedores, finalidades y plazos, y se pedirá consentimiento previo para los servicios que lo requieran.'],['Tus derechos',`Podés borrar las preferencias locales desde los ajustes de tu navegador. Si Lumendia llegara a tratar datos tuyos (por ejemplo, un correo que nos envíes), podés solicitar acceso, rectificación o supresión escribiendo a ${email}, conforme a la Ley 25.326 de Protección de Datos Personales. La Agencia de Acceso a la Información Pública es el órgano de control de esa ley.`]]},
{slug:'cookies',title:'Política de cookies',eyebrow:legalEyebrow('Cookies'),sections:[['Estado actual','No se instalan cookies de publicidad ni de analítica. Las preferencias de lectura se guardan en localStorage del navegador, sin compartirlas con el servidor.'],['Preferencias locales','lumendia-theme conserva el tema; lumendia-font, el tamaño de letra; lumendia-progress seguido del identificador del libro, el último capítulo y posición; lumendia-consent, la elección sobre servicios opcionales. Permanecen hasta que las borres desde el navegador.'],['Servicios futuros','La activación de publicidad o medición exige informar a los lectores, actualizar esta política y obtener el consentimiento aplicable antes de cargar servicios externos. Rechazar servicios opcionales no impide leer.'],['Consultas',`Responsable: ${responsible}. Contacto: ${email}.`]]},
{slug:'terminos',title:'Términos de uso',eyebrow:legalEyebrow('Términos de uso'),sections:[['Lectura y alcance','Lumendia ofrece recursos educativos para lectura gratuita. No es un servicio de atención médica, psicológica o legal. Los contenidos no reemplazan una consulta profesional ni se presentan como diagnósticos.'],['Derechos de los materiales',`Los textos, imágenes y recursos pertenecen a sus titulares. El acceso gratuito no implica una cesión de derechos ni una licencia abierta: no se permite reproducirlos o redistribuirlos sin autorización. La descarga de un recurso gratuito permite su uso personal previsto. Consultas sobre permisos: ${email}.`],['Productos externos','Los productos premium se comercializan fuera de Lumendia, a través de Galumio y las tiendas que indica. Precios, condiciones de compra, entrega y devoluciones se consultan en la plataforma correspondiente.'],['Responsable y jurisdicción',`Lumendia es operado por ${responsible}. Estos términos se rigen por las leyes de la República Argentina; ante cualquier controversia serán competentes los tribunales de ${jurisdiction}, sin perjuicio de los derechos que correspondan a los consumidores.`]]},
{slug:'politica-editorial',title:'Nuestra política editorial',eyebrow:'Transparencia',sections:[['Fidelidad y fuentes','La edición web utiliza los HTML suministrados como fuente principal y los PDF como referencia. Las adaptaciones de navegación, formato y promoción se separan del texto educativo. Las fuentes y advertencias originales se conservan.'],['Contenido sanitario',editorialReady?`Los materiales de salud se publican después de una revisión profesional. La edición actual fue revisada por ${config.editorial.reviewer} (${config.editorial.reviewedAt}). No se indica una revisión acreditada si no existe constancia de ella.`:'Los materiales de salud permanecen pendientes de aprobación editorial hasta contar con una revisión profesional adecuada. No se indica una revisión acreditada si no existe constancia de ella. La compilación de producción excluye el material que no está aprobado.'],['Límites de la información','No añadimos prescripciones, indicaciones de iniciar o suspender tratamientos, cambios de dosis, recomendaciones de medicamentos o suplementos ni procedimientos clínicos. Las dudas terapéuticas corresponden al profesional responsable.'],['Publicidad e independencia','La publicidad está desactivada. Si se habilita, deberá identificarse y mantenerse fuera de páginas de emergencia y de instrucciones sensibles. Las promociones comerciales deben distinguirse del contenido editorial.']]},
{slug:'politica-de-correcciones',title:'Cada corrección importa.',eyebrow:'Política de correcciones',sections:[['Cómo informar un problema',legalReady?`Escribí a ${email} indicando la página, el fragmento y el motivo; agregá una fuente verificable cuando corresponda. No incluyas datos clínicos identificables.`:'El canal de contacto se habilitará antes de publicar. Para solicitar una revisión, indicá la página, el fragmento y el motivo; agregá una fuente verificable cuando corresponda. No incluyas datos clínicos identificables.'],['Cómo se revisa','Los errores técnicos se corrigen en el sitio. Las observaciones sobre contenido sanitario se registran para revisión por un profesional adecuado; no se cambian indicaciones clínicas sin aprobación.'],['Registro de cambios','Las correcciones materiales deberán documentar qué se modificó, por qué y cuándo. Si un contenido presenta dudas importantes, se retirará de la publicación mientras se revisa.'],['Estado inicial','No hay correcciones editoriales publicadas.']]}
];
export function getStaticPaths(){return ['sobre-lumendia','contacto','privacidad','cookies','terminos','politica-editorial','politica-de-correcciones'].map(slug=>({params:{slug}}))}
const page=pages.find(p=>p.slug===Astro.params.slug)!;
---
<Base title={page.title} description={`${page.eyebrow}. Conocé los criterios, el alcance y el funcionamiento de Lumendia.`}><section class="section container"><div class="prose"><span class="eyebrow">{page.eyebrow}</span><h1>{page.title}</h1>{page.sections.map(([title,text])=><section><h2>{title}</h2><p>{text}</p></section>)}{page.slug==='contacto'&&config.contactEmail&&<a class="button" href={`mailto:${config.contactEmail}`}>Escribinos</a>}<a href="/biblioteca/" class="text-link">Volver a la biblioteca →</a></div></section></Base>
