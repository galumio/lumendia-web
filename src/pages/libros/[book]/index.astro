---
import Base from '../../../layouts/Base.astro';import Premium from '../../../components/Premium.astro';import Resource from '../../../components/Resource.astro';import {available,bookUrl,healthReviewed,minutes,publishable,readingOrder,type Book} from '../../../lib/catalog';
export function getStaticPaths(){return available.map(book=>({params:{book:book.slug},props:{book}}))}
interface Props {book:Book}const {book}=Astro.props;const url=bookUrl(book);const total=book.pages.reduce((n,p)=>n+p.words,0);const first=readingOrder(book)[0];const health=book.healthContent!==false;
---
<Base title={book.title} description={book.description} image={book.cover} schema={{'@type':'Book',name:book.title,inLanguage:'es',image:new URL(book.cover,Astro.site).href,isAccessibleForFree:true,numberOfPages:book.printPages,publisher:book.publisher?{'@type':'Organization',name:book.publisher}:undefined}}><section class="container section"><nav class="breadcrumb" aria-label="Ubicación"><a href="/biblioteca/">Biblioteca</a><span aria-hidden="true">/</span><span>{book.category}</span></nav><div class="book-hero"><img src={book.cover} alt={`Portada original: ${book.title}`} width="480" height="680"/><div><span class="eyebrow">{book.category} · Lectura gratuita</span><h1>{book.title}</h1><p class="subtitle">{book.subtitle}</p><p>{book.description}</p><div class="book-meta"><span>{book.toc.filter(c=>Number(c.number)>0).length} capítulos</span>{book.situations.length>0&&<span>{book.situations.length} situaciones</span>}<span>≈ {minutes(total)} min de lectura*</span></div><div class="actions"><a class="button" href={`${url}${first}/`}>Empezar a leer ↗</a>{book.premium?.highlight&&book.premium.url&&<a class="button secondary" href={book.premium.url} rel="noopener" data-event="commercial_click">{book.premium.cta??'Ver en Galumio Studio'} ↗</a>}{book.situations.length>0&&<a class="text-link" href={`${url}situaciones/`}>Buscar una situación</a>}</div><a class="arrow-link" data-resume={book.slug} hidden href={`${url}${first}/`}>Continuar leyendo</a></div></div><p class="small" style="margin-top:30px">*Estimación a 200 palabras por minuto sobre los textos web; el tiempo personal puede variar.</p>{!publishable(book)&&<p class="editorial-status">Edición de revisión. {health?'El contenido sanitario está pendiente de aprobación profesional y editorial.':'Pendiente de aprobación editorial.'}</p>}</section><section class="container book-details"><div><span class="eyebrow">Tu recorrido de lectura</span><h2>Un capítulo a la vez.</h2><ol class="toc-list">{book.toc.map(c=><li><a href={`${url}${c.slug}/`}><span>{c.number}</span>{c.title}</a></li>)}</ol></div><aside>{book.topics.length>0&&<><span class="eyebrow">Para consultar cuando lo necesites</span><h2>Lo que te pasa hoy.</h2><p>Encontrá las {book.situations.length} situaciones prácticas organizadas en {book.topics.length} temas.</p><div class="toc-list">{book.topics.map(t=><a href={`${url}${t.slug}/`}>{t.title} ↗</a>)}</div></>}<div class="editorial-status"><strong>Información editorial</strong><p>Destinada a {book.audience.toLowerCase()}. {book.publisher&&`Edición original de ${book.publisher}.`}</p>{health&&<p>{healthReviewed(book)?`Contenido revisado por ${book.healthReview!.reviewer} (${book.healthReview!.reviewedAt}).`:'No se acredita una revisión sanitaria profesional.'}</p>}{book.notice&&<p>{book.notice}</p>}{book.sourcesPage&&<a href={`${url}${book.sourcesPage}/`}>Consultar fuentes y alcance</a>}</div></aside></section><section class="container section">{(book.resources??[]).map(resource=><Resource resource={resource}/>)}{book.premium&&<Premium cover={book.cover} product={book.premium}/>}</section></Base>
