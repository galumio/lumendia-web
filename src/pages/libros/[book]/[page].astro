---
import {translator} from "../../../lib/i18n";
import Base from '../../../layouts/Base.astro';import {available,bookUrl,minutes,readingOrder,type Book,type Page} from '../../../lib/catalog';
export function getStaticPaths(){return available.flatMap(book=>book.pages.map(page=>({params:{book:book.slug,page:page.slug},props:{book,page}})))}
interface Props {book:Book;page:Page}const {book,page}=Astro.props;const url=bookUrl(book);const order=readingOrder(book);const position=order.indexOf(page.slug);const prev=book.pages.find(p=>p.slug===order[position-1]);const next=book.pages.find(p=>p.slug===order[position+1]);
const language=book.language??"es";const t=translator(language);
---
<Base language={language} title={page.title} description={page.description} image={book.cover} schema={{'@type':'Article',headline:page.title,inLanguage:language,isPartOf:{'@type':'Book',name:book.title},isAccessibleForFree:true}}><div class="container reader-shell"><aside class="reader-sidebar"><details open><summary>{t("Índice de la guía")}</summary><a href={url}>{t("Presentación del libro")}</a>{book.toc.map(c=><a href={`${url}${c.slug}/`} aria-current={c.slug===page.slug?'page':undefined}>{c.number} · {c.title}</a>)}{book.situations.length>0&&<a href={`${url}situaciones/`} aria-current={page.slug==='situaciones'?'page':undefined}>{book.situations.length} situaciones prácticas</a>}{book.topics.map(t=><a href={`${url}${t.slug}/`} aria-current={t.slug===page.slug?'page':undefined}>{t.title}</a>)}</details></aside><div class="reader-main" data-reader data-book={book.slug} data-title={page.title}><nav class="breadcrumb" aria-label={t("Ubicación")}><a href="/biblioteca/">{t("Biblioteca")}</a><span>/</span><a href={url}>{book.shortTitle??book.title}</a></nav><progress class="reader-progress" id="reading-progress" value="0" max="100" aria-label={t("Progreso de esta página")}></progress><div class="reader-tools"><label><span id="progress-label">0 %</span> {language==='en'?'of this page':'de esta página'} · ≈ {minutes(page.words)} min</label><button id="font-smaller" aria-label={t("Reducir tamaño de letra")}>A−</button><button id="font-larger" aria-label={t("Aumentar tamaño de letra")}>A+</button><button id="share">{t("Compartir")}</button><span id="reader-feedback" role="status" aria-live="polite"></span></div>{page.slug==='situaciones'&&<section class="situation-index" aria-label="Buscador de situaciones"><div data-search="situations" class="search-box"><label>¿Qué está pasando?<input type="search" placeholder="Por ejemplo: baño, noche, preguntas…"/></label><label>Tema<select><option value="">Todos los temas</option>{book.topics.map(t=><option value={t.slug}>{t.title}</option>)}</select></label><button type="button" class="button secondary">Limpiar</button></div><p data-results aria-live="polite" role="status"></p><div class="situation-results">{book.situations.map(s=><a class="situation-result" href={`${url}${s.topic}/#${s.id}`} data-search-item={s.text} data-category={s.topic}>{s.title}</a>)}</div></section>}<article class="reader-content" set:html={page.html}/>{book.sample&&book.premium?.url&&<aside class="editorial-status"><p>{book.notice}</p><a class="button" href={book.premium.url} rel="noopener" data-event="commercial_click">{book.premium.cta} ↗</a></aside>}<nav class="chapter-nav" aria-label={t("Navegación de lectura")}>{prev?<a href={`${url}${prev.slug}/`}>← {t("Anterior")}<br/>{prev.title}</a>:<a href={url}>← {t("Presentación del libro")}</a>}{next?<a href={`${url}${next.slug}/`}>{t("Siguiente")} →<br/>{next.title}</a>:<a href={url}>{t("Volver al libro")} →</a>}</nav></div></div><script src="../../../scripts/reader.ts"></script></Base>
