---
import {authorUrl} from '../../lib/editorial-authors';
import {config,minutes} from '../../lib/catalog';
import ReadingControls from '../../components/ReadingControls.astro';
import Base from '../../layouts/Base.astro';
import {scopeLabels} from '../../lib/editorial';
import {editorialEntries,sectionTitles} from '../../lib/editorial-catalog';
import type {EditorialEntry} from '../../lib/editorial-catalog';
interface Props {entry:EditorialEntry}
export function getStaticPaths(){return editorialEntries.map(entry=>({params:{section:entry.url.split('/')[1],slug:entry.slug},props:{entry}}));}
const {entry}=Astro.props;
const section=Astro.params.section!;
const schema=entry.privateDraft?undefined:{'@type':entry.format==='story'?'ShortStory':'Article',wordCount:entry.words,name:entry.title,headline:entry.title,description:entry.description,inLanguage:entry.language,isAccessibleForFree:true,author:{'@type':entry.author?.type??'Person',name:entry.author?.name,...(entry.author?.slug?{'@id':new URL(authorUrl(entry.author.slug),config.siteUrl).href,url:new URL(authorUrl(entry.author.slug),config.siteUrl).href}:{})},...(entry.publisher?{publisher:{'@type':'Organization',name:entry.publisher.name}}:{}),...(entry.publishedAt&&!entry.publicationPending?{datePublished:entry.publishedAt}:{}),...(entry.reviewedAt?{dateModified:entry.reviewedAt}:{})};
---
<Base title={entry.title} description={entry.description} language={entry.language} image="/favicon.svg" schema={schema}><section class:list={["container section editorial-reader",{"story-reader":entry.format==='story'}]}><nav aria-label={entry.language==='es'?'Ruta de navegación':'Breadcrumb'}><a href="/biblioteca/">Biblioteca</a> / <a href={`/${section}/`}>{sectionTitles[section]}</a></nav>{entry.format==='story'?<header class="story-header"><h1>{entry.title}</h1><p class="story-author">{entry.author?.slug?<a href={authorUrl(entry.author.slug)}>{entry.author.name}</a>:entry.author?.name}</p><p class="story-scope">{scopeLabels[entry.language][entry.scope]} · {minutes(entry.words)} minutos</p><a class="story-start" href="#relato">Empezar a leer</a><details class="story-details"><summary>Sobre este relato</summary><p>{entry.description}</p><p>{entry.words.toLocaleString('es-AR')} palabras · {entry.language==='es'?'Español':'English'} · {entry.topics.join(' · ')}</p>{entry.publisher&&<p>Sello editorial: {entry.publisher.name}</p>}<p>Público: {entry.audiences.join(' · ')}.</p>{entry.publicationPending&&<p>Contenido aprobado · Publicación pendiente</p>}{entry.privateDraft&&<p>Borrador privado · Pendiente de aprobación editorial</p>}{entry.publishedAt&&<p>Publicación: <time datetime={entry.publishedAt}>{entry.publishedAt}</time></p>}{entry.reviewedAt&&<p>Revisión: <time datetime={entry.reviewedAt}>{entry.reviewedAt}</time></p>}</details></header>:<header><p>{entry.privateDraft?'Borrador privado · Pendiente de aprobación editorial':scopeLabels[entry.language][entry.scope]}</p>{entry.publicationPending&&<p>Contenido aprobado · Publicación pendiente</p>}<h1>{entry.title}</h1><p>{entry.description}</p><p>{entry.words.toLocaleString('es-AR')} palabras · {entry.language==='es'?'Español':'English'}</p>{entry.author?.name&&<p>{entry.privateDraft?'Atribución editorial propuesta: ':''}{entry.author.slug?<a href={authorUrl(entry.author.slug)}>{entry.author.name}</a>:entry.author.name}</p>}{entry.publisher&&<p>Sello editorial: {entry.publisher.name}</p>}{entry.format==='story'&&<p>Ficción · {entry.topics.join(' · ')} · Aproximadamente {minutes(entry.words)} minutos de lectura</p>}{entry.publishedAt&&<p>Publicación: <time datetime={entry.publishedAt}>{entry.publishedAt}</time></p>}{entry.reviewedAt&&<p>Revisión: <time datetime={entry.reviewedAt}>{entry.reviewedAt}</time></p>}<p>Temas: {entry.topics.join(' · ')}. Público: {entry.audiences.join(' · ')}.</p></header>}<ReadingControls language={entry.language}/>{entry.format==='story'&&entry.toc.length===0&&<nav id="reading-index" aria-label="Navegación del relato"><a href="/relatos/">Índice de relatos</a> · <a href="#relato">Leer el relato</a></nav>}{entry.toc.length>0&&<nav id="reading-index" class="editorial-toc" aria-label={entry.format==='tutorial'?'En este tutorial':'En esta guía'}><h2>{entry.format==='tutorial'?'En este tutorial':'En esta guía'}</h2><ul>{entry.toc.map(item=><li><a href={`#${item.id}`}>{item.title}</a></li>)}</ul></nav>}<article id="relato" aria-label={entry.title} class="reader-content" set:html={entry.html}/>{entry.sources.length>0&&<section aria-labelledby="fuentes"><h2 id="fuentes">Fuentes y ayuda oficial</h2><p>Fuentes consultadas para este contenido.</p><ul>{entry.sources.map(s=><li><a href={s.url} rel="noreferrer">{s.title}</a></li>)}</ul></section>}{entry.relatedLinks.length>0&&<nav aria-labelledby="relacionados"><h2 id="relacionados">Para seguir leyendo</h2><p>Estas lecturas complementan {entry.format==='story'?'el relato':entry.format==='tutorial'?'el tutorial':'la guía'}. Sus fichas indican si ofrecen contenido completo o una muestra comercial.</p><ul>{entry.relatedLinks.map(r=><li><a href={r.url}>{r.title}</a></li>)}</ul></nav>}<p><a href="#contenido">Volver al comienzo</a></p></section><script src="../../scripts/editorial-reader.ts"></script></Base>
<style>.editorial-reader{max-width:850px;overflow-wrap:anywhere}.editorial-reader h1{font-size:clamp(2rem,5vw,3.4rem)}.editorial-toc a,.editorial-reader>nav a,.editorial-reader>section a{display:inline-block;padding:10px 0;min-height:44px}.editorial-toc ul{padding-left:24px}.editorial-reader :global(blockquote){margin:24px 0;padding:16px 22px;border-left:4px solid var(--green);background:var(--soft)}.editorial-reader :global(h2[id]){scroll-margin-top:24px}.editorial-reader :global(.copy-prompt){min-height:44px;min-width:44px}.editorial-reader :global(.copy-prompt:focus-visible){outline:3px solid var(--gold);outline-offset:4px}.editorial-reader :global(.copy-feedback){font:15px/1.6 var(--sans)}.story-header h1{margin:12px 0 8px}.story-header p{margin:8px 0}.story-author a,.story-start{display:inline-flex;align-items:center;min-height:44px}.story-author{font-weight:600}.story-details summary{cursor:pointer;min-height:44px;display:list-item;padding:10px 0}.story-details{margin:4px 0 12px}.story-header a:focus-visible,.story-details summary:focus-visible{outline:3px solid var(--green);outline-offset:3px}@media(max-width:600px){.story-reader{padding-top:20px}.story-header h1{margin-top:8px}.story-header .story-author{margin:0}.story-header .story-scope{font-size:15px;line-height:1.5}.story-reader>nav{font-size:15px}.story-reader :global(.ux-reading-controls){margin:12px 0}}
</style>
