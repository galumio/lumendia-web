---
import Base from '../../layouts/Base.astro';
import {scopeLabels} from '../../lib/editorial';
import {editorialEntries,sectionTitles} from '../../lib/editorial-catalog';
import type {EditorialEntry} from '../../lib/editorial-catalog';
interface Props {entry:EditorialEntry}
export function getStaticPaths(){return editorialEntries.map(entry=>({params:{section:entry.url.split('/')[1],slug:entry.slug},props:{entry}}));}
const {entry}=Astro.props;
const section=Astro.params.section!;
const schema=entry.privateDraft?undefined:{'@type':'Article',headline:entry.title,description:entry.description,inLanguage:entry.language,isAccessibleForFree:true,author:{'@type':entry.author?.type??'Person',name:entry.author?.name},...(entry.publishedAt&&!entry.publicationPending?{datePublished:entry.publishedAt}:{}),...(entry.reviewedAt?{dateModified:entry.reviewedAt}:{})};
---
<Base title={entry.title} description={entry.description} language={entry.language} image="/favicon.svg" schema={schema}><section class="container section editorial-reader"><nav aria-label={entry.language==='es'?'Ruta de navegación':'Breadcrumb'}><a href="/biblioteca/">Biblioteca</a> / <a href={`/${section}/`}>{sectionTitles[section]}</a></nav><header><p>{entry.privateDraft?'Borrador privado · Pendiente de aprobación editorial':scopeLabels[entry.language][entry.scope]}</p>{entry.publicationPending&&<p>Contenido aprobado · Publicación pendiente</p>}<h1>{entry.title}</h1><p>{entry.description}</p><p>{entry.words.toLocaleString('es-AR')} palabras · {entry.language==='es'?'Español':'English'}</p>{entry.author?.name&&<p>{entry.privateDraft?'Atribución editorial propuesta: ':''}{entry.author.name}</p>}{entry.publishedAt&&<p>Publicación: <time datetime={entry.publishedAt}>{entry.publishedAt}</time></p>}{entry.reviewedAt&&<p>Revisión: <time datetime={entry.reviewedAt}>{entry.reviewedAt}</time></p>}<p>Temas: {entry.topics.join(' · ')}. Público: {entry.audiences.join(' · ')}.</p></header><nav class="editorial-toc" aria-label="En esta guía"><h2>En esta guía</h2><ul>{entry.toc.map(item=><li><a href={`#${item.id}`}>{item.title}</a></li>)}</ul></nav><article class="reader-content" set:html={entry.html}/><section aria-labelledby="fuentes"><h2 id="fuentes">Fuentes y ayuda oficial</h2><p>Fuentes consultadas para este contenido.</p><ul>{entry.sources.map(s=><li><a href={s.url} rel="noreferrer">{s.title}</a></li>)}</ul></section>{entry.relatedLinks.length>0&&<nav aria-labelledby="relacionados"><h2 id="relacionados">Para seguir leyendo</h2><p>Estas lecturas complementan la guía. Sus fichas indican si ofrecen contenido completo o una muestra comercial.</p><ul>{entry.relatedLinks.map(r=><li><a href={r.url}>{r.title}</a></li>)}</ul></nav>}<p><a href="#contenido">Volver al comienzo</a></p></section><script src="../../scripts/editorial-reader.ts"></script></Base>
<style>.editorial-reader{max-width:850px;overflow-wrap:anywhere}.editorial-reader h1{font-size:clamp(2rem,5vw,3.4rem)}.editorial-toc a,.editorial-reader>nav a,.editorial-reader>section a{display:inline-block;padding:10px 0;min-height:44px}.editorial-toc ul{padding-left:24px}.editorial-reader :global(blockquote){margin:24px 0;padding:16px 22px;border-left:4px solid var(--green);background:var(--soft)}.editorial-reader :global(h2[id]){scroll-margin-top:24px}.editorial-reader :global(.copy-prompt){min-height:44px;min-width:44px}.editorial-reader :global(.copy-prompt:focus-visible){outline:3px solid var(--gold);outline-offset:4px}.editorial-reader :global(.copy-feedback){font:15px/1.6 var(--sans)}</style>
