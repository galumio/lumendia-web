---
import Base from '../../layouts/Base.astro';
import {editorialEntries,sectionTitles} from '../../lib/editorial-catalog';
import {editorialIndexes} from '../../lib/editorial-content.mjs';
import {scopeLabels} from '../../lib/editorial';
export function getStaticPaths(){return editorialIndexes(editorialEntries).map(url=>({params:{section:url.split('/')[1]}}));}
const section=Astro.params.section!;
const entries=editorialEntries.filter(e=>e.url.split('/')[1]===section);
---
<Base title={`${sectionTitles[section]} gratuitas`} description={`Lecturas originales de Lumendia: ${sectionTitles[section].toLowerCase()} para aprender y practicar a tu ritmo.`} image="/favicon.svg"><section class="container section"><a href="/biblioteca/">← Biblioteca</a><h1>{sectionTitles[section]} gratuitas</h1>{entries.map(e=><div class="editorial-note"><p>{e.privateDraft?'Borrador privado para revisión local':scopeLabels.es[e.scope]}</p><h2><a href={e.url}>{e.title}</a></h2><p>{e.description}</p></div>)}</section></Base>
