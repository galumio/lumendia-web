---
import {tipGroups} from '../../lib/tips.mjs';
import type {EditorialEntry} from '../../lib/editorial-catalog';
import {authorUrl} from '../../lib/editorial-authors';
import {minutes} from '../../lib/catalog';
import Base from '../../layouts/Base.astro';
import {editorialEntries,sectionTitles} from '../../lib/editorial-catalog';
import {editorialIndexes} from '../../lib/editorial-content.mjs';
import {scopeLabels} from '../../lib/editorial';
export function getStaticPaths(){return editorialIndexes(editorialEntries).map(url=>({params:{section:url.split('/')[1]}}));}
const section=Astro.params.section!;
const entries=editorialEntries.filter(e=>e.url.split('/')[1]===section);
const title=section==='tips'?'Tips de IA gratuitos':section==='relatos'?'Relatos gratuitos':`${sectionTitles[section]} gratuitas`;
const groups=tipGroups(entries);
const description=section==='relatos'?'Relatos originales de ficción para leer completos y gratis en Lumendia.':`Lecturas originales de Lumendia: ${sectionTitles[section].toLowerCase()} para aprender y practicar a tu ritmo.`;
---
<Base title={title} description={description} image="/favicon.svg"><section class="container section"><a href="/biblioteca/">← Biblioteca</a><h1>{title}</h1>{section==='tips'?<><p>Lecturas breves, completas y gratuitas, sin registro. Cada tip incluye una situación cotidiana, un pedido para copiar y una comprobación. Para profundizar, seguí los enlaces a guías, tutoriales y fichas de libros.</p><h2>Cómo leer esta colección</h2><p>Los pedidos usan ejemplos ficticios que podés adaptar. No hace falta conocer términos técnicos: escribí en el chat qué necesitás y revisá lo que devuelve. Los resultados que mostramos son ejemplos editoriales, no respuestas obtenidas de una herramienta ni resultados garantizados.</p><p>Todos los ejercicios pueden hacerse con texto. Una foto o un archivo solo sirven si la herramienta que elegiste permite adjuntarlos y leerlos; esa capacidad no se da por supuesta. Si no puede leer algo, no le pidas que lo adivine. Compartí únicamente la información necesaria y no incluyas contraseñas, códigos de acceso ni datos personales de otras personas.</p><nav aria-label="Temas de tips"><ul>{groups.map(group=><li><a href={`#${group.id}`}>{group.title} ({group.entries.length})</a></li>)}</ul></nav>{groups.map(group=><section aria-labelledby={group.id}><h2 id={group.id}>{group.title}</h2>{group.entries.map((e:EditorialEntry)=><div class="editorial-note"><p>Tip · Lectura completa gratuita{e.publicationPending?' · Publicación pendiente':''}</p><h3><a href={e.url}>{e.title}</a></h3><p>{e.description}</p><p>{e.words} palabras · Español</p></div>)}</section>)}</>:entries.map(e=><div class="editorial-note"><p>{e.privateDraft?'Borrador privado para revisión local':scopeLabels.es[e.scope]}</p><h2><a href={e.url}>{e.title}</a></h2>{e.format==='story'&&<p>{e.author?.slug?<a href={authorUrl(e.author.slug)}>{e.author.name}</a>:e.author?.name} · {e.topics.join(' · ')} · {minutes(e.words)} minutos aproximadamente</p>}<p>{e.description}</p></div>)}</section></Base>

<style>nav a{display:inline-block;padding:10px 0;min-height:44px}h2[id]{scroll-margin-top:24px}</style>
