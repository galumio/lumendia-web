---
import Base from '../layouts/Base.astro';
import BookCard from '../components/BookCard.astro';
import Resource from '../components/Resource.astro';
import AdSlot from '../components/AdSlot.astro';
import {available,categories,featured,resources} from '../lib/catalog';
const count=(c:string)=>available.filter(b=>b.category===c).length;
const featuredNumber=featured?String(categories.indexOf(featured.category)+1).padStart(2,'0'):'';
---
<Base title="El conocimiento te lleva más lejos" image={featured?.cover} schema={{'@type':'WebSite',name:'Lumendia',url:'https://lumendia.com.ar',inLanguage:'es-AR',publisher:{'@type':'Organization',name:'Galumio Studio'}}}><section class="hero container"><div class="hero-copy"><span class="eyebrow"><span class="tiny-line"></span>Conocimiento abierto, posibilidades infinitas</span><h1>El conocimiento<br/>te lleva <em>más lejos.</em></h1><p>Una biblioteca digital donde el conocimiento está al alcance de todos. Explorá guías, ebooks y recursos educativos para aprender y encontrar respuestas prácticas.</p><div class="actions"><a class="button" href="/biblioteca/">Explorar la biblioteca <span aria-hidden="true">↗</span></a><a class="text-link" href="/sobre-lumendia/">Conocé Lumendia</a></div><div class="hero-foot"><span class="sun" aria-hidden="true">✳</span><span>Leer. Comprender. Ir más allá.<br/><strong>Gratis y a tu ritmo.</strong></span></div></div>{featured&&<div class="hero-art"><div class="art-orbit" aria-hidden="true"></div><span class="vertical-label">UNA BIBLIOTECA PARA LA VIDA REAL</span><div class="cover-stage"><img src={featured.cover} alt={`Portada de ${featured.title}`} width="480" height="680" fetchpriority="high"/></div><div class="art-caption"><span>{featuredNumber} / {featured.category.toUpperCase()}</span><span>{featured.subtitle}</span></div></div>}</section><div class="benefit-strip"><div class="container"><span>✓ Lectura gratuita</span><span>✓ Desde cualquier dispositivo</span><span>✓ Organizado por capítulos</span><span>✓ Recursos prácticos</span></div></div><section class="section container"><div class="section-heading"><div><span class="eyebrow">{available.length>1?'Nuestras lecturas':'Nuestra primera lectura'}</span><h2>Conocimiento que acompaña.</h2></div><a class="arrow-link" href="/biblioteca/">Ver biblioteca ↗</a></div>{featured?<div class="book-list">{[featured,...available.filter(x=>x!==featured)].map(book=><BookCard book={book}/>)}</div>:<div class="pending-card"><h3>Estamos preparando nuestra primera guía.</h3><p>La compartiremos cuando esté lista.</p></div>}</section><section class="section categories-section"><div class="container"><span class="eyebrow">Un mundo por descubrir</span><h2>¿Qué querés aprender?</h2><p class="section-intro">Empezamos con guías prácticas. Nuevos temas se sumarán a nuestra biblioteca.</p><div class="categories">{categories.map((c,i)=><a href={`/biblioteca/?categoria=${encodeURIComponent(c)}`} class:list={['category',{'active':count(c)>0}]}><span class="category-number">0{i+1}</span><h3>{c}</h3><span>{count(c)?`${count(c)} ${count(c)===1?'publicación':'publicaciones'} · Explorar ↗`:'Próximamente'}</span></a>)}</div></div></section>{resources.length>0&&<section class="section container"><Resource resource={resources[0].resource}/><AdSlot sensitive={false}/></section>}<section class="closing container"><span class="sun" aria-hidden="true">✳</span><h2>Aprender también es<br/>una forma de cuidarnos.</h2><p>Ideas claras. Lecturas a tu ritmo. Herramientas para todos los días.</p><a class="text-link" href="/sobre-lumendia/">Nuestra forma de compartir conocimiento ↗</a></section></Base>
