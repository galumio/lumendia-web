---
import Discovery from '../layouts/Discovery.astro';
import Tile from '../components/DiscoveryTile.astro';
import BookCard from '../components/BookCard.astro';
import {available} from '../lib/catalog';
import {readingScope} from '../lib/editorial';
import {editorialEntries} from '../lib/editorial-catalog';
import {availableAuthors} from '../lib/editorial-authors';
import {publishedBook,publicationDate,selectLatest,featuredIds,argentinaToday} from '../lib/discovery.mjs';
const items=[...available.map(book=>({id:'book:'+book.slug,kind:'book',book,scope:readingScope(book),eligible:publishedBook(book),published:publishedBook(book),draft:book.editorialStatus!=='approved',date:publicationDate(book.slug)})),...editorialEntries.filter(e=>e.format==='story').map(story=>({id:'story:'+story.slug,kind:'story',story,scope:story.scope,eligible:!story.privateDraft&&!story.publicationPending,published:!!story.publishedAt&&!story.publicationPending,draft:story.privateDraft,date:story.publishedAt}))];
const latest=selectLatest(items,{today:argentinaToday(),manual:featuredIds,limit:3});
---
<Discovery title="Un libro puede abrirte un camino." description="Lecturas completas y gratuitas, ideas para aprender y herramientas para lo cotidiano."><a class="button" href="/biblioteca/">Explorá la biblioteca</a><section class="design-section"><h2>Novedades para leer</h2><div class="reading-grid">{latest.map(item=>item.kind==='book'?<BookCard book={item.book}/>:<article class="book-card story-feature"><div class="book-cover"><img src={availableAuthors.find(a=>a.slug===item.story.author?.slug)?.logo} width="640" height="640" alt={`Logo oficial de ${item.story.author?.name}`} decoding="async"/></div><div class="book-card-copy"><span class="eyebrow">Relato · {item.story.author?.name}</span><h2><a href={item.story.url}>{item.story.title}</a></h2><p>{item.story.description}</p><div class="book-meta"><span>Lectura completa gratuita</span><span>Identidad del autor · no es una portada del relato</span></div><a class="arrow-link" href={item.story.url}>Leer el relato →</a></div></article>)}</div></section><section class="design-section"><h2>¿Por dónde querés empezar?</h2><div class="reading-grid"><Tile title="Relatos" description="Historias para leer completas." href="/relatos/"/><Tile title="Aprendé IA" description="Tips, guías y tutoriales, a tu ritmo." href="/aprende-ia/"/><Tile title="Herramientas" description="Prepará un pedido con el generador gratuito." href="/herramientas/"/></div></section></Discovery>
