---
import Base from '../../layouts/Base.astro';
import {availableAuthors,authorUrl} from '../../lib/editorial-authors';
import {editorialEntries} from '../../lib/editorial-catalog';
import {config,minutes} from '../../lib/catalog';
export function getStaticPaths(){return availableAuthors.map(author=>({params:{slug:author.slug},props:{author}}));}
const {author}=Astro.props;
const stories=editorialEntries.filter(e=>e.format==='story'&&e.author?.slug===author.slug);
const schema={'@type':'ProfilePage',mainEntity:{'@type':'Person','@id':new URL(authorUrl(author.slug),config.siteUrl).href,name:author.name,description:author.description,sameAs:[author.tiktok],image:new URL(author.logo,config.siteUrl).href}};
---
<Base title={author.name} description={author.description} schema={schema}>
 <div class="container section author-page">
  <a class="back-link" href="/relatos/">← Relatos gratuitos</a>
  <header class="author-heading">
   <img class="author-logo" src={author.logo} width="640" height="640" alt="Logo oficial de Gael Beltra: monograma GB dorado, nombre del autor y escritorio oscuro" decoding="async"/>
   <div class="author-intro">
   <p class="eyebrow">Espacio de autor · {author.publisher}</p>
   <h1>{author.name}</h1>
   <p class="author-genres">{author.genres.join(' · ')}</p>
   <p>Relatos para leer completos y gratis en Lumendia. Novelas comerciales para conocer en Amazon.</p>
   <nav class="category-links" aria-label="En esta página"><a href="#relatos-gratuitos">Relatos gratuitos</a><a href="#novelas-amazon">Novelas en Amazon</a></nav>
   <a class="back-link" href={author.tiktok} rel="noreferrer">Seguí a Gael Beltra en TikTok</a>
   </div>
  </header>
  <section aria-labelledby="relatos-gratuitos" class="author-section">
   <h2 id="relatos-gratuitos">Relatos gratuitos</h2>
   <div class="author-grid">{stories.map(e=><article class="editorial-note story-card">
    <p class="small">Lectura completa gratuita · {minutes(e.words)} minutos aproximadamente</p>
    <h3>{e.title}</h3><p>{e.description}</p>
    <a class="card-link" href={e.url} aria-label={`Leer completo: ${e.title}`}>Leer el relato completo <span aria-hidden="true">→</span></a>
   </article>)}</div>
  </section>
  <section aria-labelledby="novelas-amazon" class="author-section">
   <h2 id="novelas-amazon">Novelas en Amazon</h2>
   <p>Obras comerciales de Gael Beltra. Los enlaces llevan a sus fichas en Amazon.</p>
   <div class="author-grid novels-grid">{author.novels.map(n=><article class="editorial-note novel-card">
    <img class="novel-cover" src={n.cover} width={n.coverWidth} height={n.coverHeight} alt={`Portada oficial de ${n.title}, de Gael Beltra`} loading="lazy" decoding="async"/>
    <p class="small">Novela · Obra comercial</p><h3>{n.title}</h3><p class="novel-genre">{n.genre}</p><p class="novel-description">{n.description}</p>
    <a class="card-link" href={n.url} rel="noreferrer" aria-label={`Ver en Amazon: ${n.title}`}>Ver en Amazon <span aria-hidden="true">↗</span></a>
   </article>)}</div>
  </section>
 </div>
</Base>
<style>
 .author-page{overflow-wrap:anywhere}.back-link,.card-link{display:inline-flex;align-items:center;min-height:44px;gap:8px}
 .author-heading{display:grid;grid-template-columns:240px minmax(0,1fr);gap:36px;align-items:center;padding-block:28px 12px}.author-logo{width:100%;height:auto;display:block;border-radius:6px}.author-intro{min-width:0}.novel-cover{display:block;width:auto;max-width:100%;height:320px;object-fit:contain;align-self:center;margin-bottom:20px}.author-heading h1{font-size:clamp(2.6rem,6vw,4.8rem);margin:14px 0}.author-genres{font-family:var(--serif);font-size:1.2rem}
 .author-section{padding-top:32px}.author-section h2{scroll-margin-top:24px}.author-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.novels-grid{grid-template-columns:repeat(3,minmax(0,1fr))}
 .author-grid .editorial-note{margin:0;display:flex;flex-direction:column;padding:24px}.author-grid h3{font-family:var(--serif);font-size:1.6rem;line-height:1.3;margin:10px 0}.card-link{margin-top:auto;padding-top:16px;font-weight:600;align-self:flex-start}
 @media(max-width:760px){.author-grid{grid-template-columns:1fr}.author-heading{padding-top:20px;grid-template-columns:1fr;gap:20px}.author-logo{width:200px}.novel-cover{height:auto;width:220px}.author-grid .editorial-note{padding:20px}.author-section{padding-top:24px}}
</style>
