---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import {translator} from "../lib/i18n";
import '../styles/global.css';
import '../styles/ux.css';
import {approvedAnalytics} from '../lib/analytics-policy.mjs';
import {config,featured,preview,dryRun} from '../lib/catalog';
interface Props {disableMeasurement?:boolean;language?:"es"|"en";title:string;description?:string;image?:string;schema?:Record<string,unknown>}
const {title,description='Una biblioteca digital donde el conocimiento está al alcance de todos. Guías, ebooks y recursos educativos para aprender.',schema} = Astro.props;const image=Astro.props.image??featured?.cover??'/favicon.svg';
const canonical=new URL(Astro.url.pathname,config.siteUrl);const notFound=Astro.url.pathname.startsWith('/404');
const language=Astro.props.language??"es";const t=translator(language);


---
<!doctype html><html lang={language==='en'?'en':'es-AR'}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>{title} | Lumendia</title><meta name="description" content={description}/>{!notFound&&<link rel="canonical" href={canonical}/>}<meta property="og:title" content={`${title} | Lumendia`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/>{!notFound&&<meta property="og:url" content={canonical}/>}<meta property="og:image" content={new URL(image,config.siteUrl)}/><meta property="og:locale" content={language==='en'?'en_US':'es_AR'}/><meta name="twitter:card" content="summary_large_image"/><meta name="theme-color" content="#153f35"/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/>{preview&&<meta name="robots" content="noindex,nofollow"/>}{config.searchConsoleVerification&&<meta name="google-site-verification" content={config.searchConsoleVerification}/>}{schema&&<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org',...schema}).replace(/</g,'\u003c')}/>}
<script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('lumendia-theme')||'light'}catch{}</script>
</head><body data-ux data-measurement={!Astro.props.disableMeasurement&&!preview&&!dryRun&&approvedAnalytics(config)?'cloudflare':undefined}><a href="#contenido" class="skip">{t("Saltar al contenido")}</a>{preview&&<div class="preview-note">{t("Vista local de revisión · Contenido pendiente de aprobación editorial.")}</div>}<SiteHeader language={language}/><main id="contenido"><slot/></main><SiteFooter language={language}/><dialog id="privacy-dialog" aria-labelledby="privacy-title"><h2 id="privacy-title">{t("Tu privacidad")}</h2><p>{t("Las preferencias de lectura se guardan en este navegador. La publicidad está desactivada. Cloudflare Web Analytics solo se carga en producción si aceptás la medición opcional.")}</p><p id="consent-description" hidden>{t("Cloudflare mide visitas, páginas vistas, países, referentes y rendimiento sin cookies de analítica. Podés rechazar o retirar tu consentimiento aquí. Al retirarlo se recarga la página y se impiden nuevas cargas; las mediciones ya enviadas no pueden retirarse y un envío en curso podría completarse.")}</p><p id="consent-state" role="status"></p><p id="consent-status" role="status"></p><div class="actions"><button class="button secondary" id="consent-reject">{t("Rechazar medición")}</button><button class="button" id="consent-accept" hidden>{t("Aceptar medición opcional")}</button><button class="button secondary" id="privacy-close">{t("Cerrar")}</button></div></dialog><script src="../scripts/ux-navigation.ts"></script><script src="../scripts/site.ts"></script><script src="../scripts/integrations.ts"></script></body></html>
