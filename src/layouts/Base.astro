---
import {translator} from "../lib/i18n";
import '../styles/global.css';
import {config,featured,preview} from '../lib/catalog';
interface Props {language?:"es"|"en";title:string;description?:string;image?:string;schema?:Record<string,unknown>}
const {title,description='Una biblioteca digital donde el conocimiento está al alcance de todos. Guías, ebooks y recursos educativos para aprender.',schema} = Astro.props;const image=Astro.props.image??featured?.cover??'/favicon.svg';
const canonical=new URL(Astro.url.pathname,config.siteUrl);const notFound=Astro.url.pathname.startsWith('/404');
const language=Astro.props.language??"es";const t=translator(language);
const links=[['/biblioteca/','Biblioteca'],['/recursos/','Recursos gratuitos'],['/sobre-lumendia/','Sobre Lumendia']];
---
<!doctype html><html lang={language==='en'?'en':'es-AR'}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>{title} | Lumendia</title><meta name="description" content={description}/>{!notFound&&<link rel="canonical" href={canonical}/>}<meta property="og:title" content={`${title} | Lumendia`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/>{!notFound&&<meta property="og:url" content={canonical}/>}<meta property="og:image" content={new URL(image,config.siteUrl)}/><meta property="og:locale" content={language==='en'?'en_US':'es_AR'}/><meta name="twitter:card" content="summary_large_image"/><meta name="theme-color" content="#153f35"/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/>{preview&&<meta name="robots" content="noindex,nofollow"/>}{config.searchConsoleVerification&&<meta name="google-site-verification" content={config.searchConsoleVerification}/>}{schema&&<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org',...schema}).replace(/</g,'\u003c')}/>}
<script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('lumendia-theme')||'light'}catch{}</script>
</head><body><a href="#contenido" class="skip">{t("Saltar al contenido")}</a>{preview&&<div class="preview-note">{t("Vista local de revisión · Contenido sanitario pendiente de aprobación editorial.")}</div>}<header class="header"><div class="container header-inner"><a href="/" class="brand" aria-label={t("Lumendia, inicio")}><span class="brand-symbol" aria-hidden="true">✳</span>lumendia<span class="brand-dot">.</span></a><nav aria-label={t("Principal")}>{links.map(([href,label])=><a href={href} aria-current={Astro.url.pathname===href?'page':undefined}>{t(label)}</a>)}</nav><button class="icon-button" id="theme" aria-label={t("Activar modo oscuro")} title={t("Cambiar tema")}>◐</button></div></header><main id="contenido"><slot/></main><footer><div class="container footer-grid"><div><a href="/" class="brand">lumendia<span class="brand-dot">.</span></a><p>{t("El conocimiento te lleva más lejos.")}</p><p class="small">{t("Una biblioteca abierta a nuevas ideas.")}<br/>{t("Argentina · En español")}</p></div><div><strong>{t("Explorá")}</strong><a href="/biblioteca/">{t("Biblioteca")}</a><a href="/recursos/">{t("Recursos gratuitos")}</a><a href="/sobre-lumendia/">{t("Sobre Lumendia")}</a><a href="/contacto/">{t("Contacto")}</a></div><div><strong>{t("Transparencia")}</strong><a href="/politica-editorial/">{t("Política editorial")}</a><a href="/politica-de-correcciones/">{t("Correcciones")}</a><a href="/privacidad/">{t("Privacidad")}</a><a href="/cookies/">{t("Cookies")}</a><a href="/terminos/">{t("Términos de uso")}</a></div></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} Lumendia</span><span>{t("Un proyecto de Galumio Studio.")}</span><button id="privacy-settings" class="text-button">{t("Preferencias de privacidad")}</button></div></footer><dialog id="privacy-dialog"><h2>{t("Tu privacidad")}</h2><p>{t("Las preferencias de lectura se guardan únicamente en este navegador. La publicidad y la analítica están desactivadas.")}</p><p id="consent-description" hidden>{t("Podés aceptar o rechazar la analítica y publicidad opcionales. Podés cambiar esta elección en cualquier momento.")}</p><div class="actions"><button class="button secondary" id="consent-reject">{t("Rechazar opcionales")}</button><button class="button" id="consent-accept" hidden>{t("Aceptar opcionales")}</button><button class="button secondary" id="privacy-close">{t("Cerrar")}</button></div></dialog><script src="../scripts/site.ts"></script><script src="../scripts/integrations.ts"></script></body></html>

